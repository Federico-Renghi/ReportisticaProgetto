@page
@using Reportistica.Models
@model InserimentoModel
@{
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/inserimento.css" />
}

<h1>Nuova visualizzazione</h1>

<form method="post" id="formVisione" class="form-vertical">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="UtenteId" name="UtenteId" value="@Model.UtenteId" />

    <label>Tipo di show</label>
    <select id="tipoShow">
        <option value="">-- seleziona --</option>
        @foreach (var t in Enum.GetValues(typeof(TipoShow)))
        {
            <option value="@t">@t</option>
        }
    </select>

    <label>Show</label>
    <select id="show" disabled>
        <option value="">-- seleziona --</option>
    </select>

    <label>Episodio</label>
    <select id="episodio" name="EpisodioId" required disabled>
        <option value="">-- seleziona --</option>
    </select>

    <label>Data visione</label>
    <input type="date" asp-for="DataVisione" name="DataVisione" required />

    <div class="form-actions">
        <button type="submit">Salva</button>

        <button
            type="button"
            class="btn-secondary"
            onclick="window.location.href='/'">
            Torna alla dashboard
        </button>
    </div>
</form>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <p class="form-error">@Model.ErrorMessage</p>
}

<script src="/js/inserimento.js"></script>