@page
@model StatsModel
@{
    Layout = "_Layout";
}

<h1>Statistiche utente @Model.Username</h1>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <p style="color:red">@Model.ErrorMessage</p>
}
else
{
    <h2>Watchtime totale:</h2>
    <p>@Model.WatchtimeMinuti minuti (@Model.WatchtimeOre ore)</p>

    <h2>Watchtime per tipo di show</h2>
    <div id="piechart" style="width: 600px; height: 400px;"></div>

    <h2>Attività settimanale</h2>
    <div id="columnchart" style="width: 700px; height: 400px;"></div>

    @if (!string.IsNullOrEmpty(Model.MesePicco))
    {
        <h2>Picco mensile</h2>
        <p>
            <strong>@Model.MesePicco</strong> —
            @Model.MinutiPiccoMensile minuti visti
        </p>
    }

}

<a href="/">Torna alla dashboard</a>

@section Scripts {
    <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>

    <script>
        google.charts.load('current', { packages: ['corechart'] });
        google.charts.setOnLoadCallback(drawCharts);

        function drawCharts() {
            drawPieChart();
            drawColumnChart();
        }

        function drawPieChart() {
            var rows = @Html.Raw(
                            System.Text.Json.JsonSerializer.Serialize(Model.WatchtimePerTipo)
                            );

        if (!rows || rows.length === 0) return;

            var data = new google.visualization.DataTable();
            data.addColumn('string', 'Tipo');
            data.addColumn('number', 'Minuti');

            data.addRows(
                rows.map(x => [x.Tipo, x.Minuti])
            );

            var options = {
                pieHole: 0.4
            };

            var chart = new google.visualization.PieChart(
                document.getElementById('piechart')
            );

            chart.draw(data, options);
        }

        function drawColumnChart() {
            var rows = @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(Model.WatchtimePerGiorno)
                        );

        if (!rows || rows.length === 0) return;

            var data = new google.visualization.DataTable();
            data.addColumn('string', 'Giorno');
            data.addColumn('number', 'Episodi');

            data.addRows(
                rows.map(x => [x.Giorno, x.Episodi])
            );

            var options = {
                legend: { position: 'none' },

                hAxis: {
                    title: 'Giorno della settimana',
                },

                vAxis: {
                    title: 'Episodi visti',
                    minValue: 0,
                    format: '0'
                },

                bar: { groupWidth: '60%' },
                chartArea: { width: '80%', height: '70%' }
            };

            var chart = new google.visualization.ColumnChart(
                document.getElementById('columnchart')
            );

            chart.draw(data, options);
        }
    </script>
}