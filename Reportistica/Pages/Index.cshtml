@page
@model IndexModel
@{
    Layout = "_Layout";
}

<div class="index-container">
    <h1>Ciao <span id="username">@Model.Username</span>!</h1>

<div class="cards-container">
    <div class="cards-side cards-left">
        <a href="/Stats?utenteId=@Model.UtenteId" class="card-link" data-direction="left">
            <div class="card">
                <h2>Statistiche</h2>
                <p>Visualizza tutti i dati e le statistiche delle tue visioni</p>
            </div>
        </a>
    </div>

    <div class="cards-side cards-right">
        <a href="/Inserimento?utenteId=@Model.UtenteId" class="card-link" data-direction="right">
            <div class="card">
                <h2>Aggiungi visione</h2>
                <p>Registra un nuovo episodio o film che hai visto</p>
            </div>
        </a>
    </div>
</div>



@section Scripts {
    <script>
        document.querySelectorAll('.card-link').forEach(link => {
            link.addEventListener('click', e => {
                e.preventDefault();
                const href = link.href;
                const dir = link.dataset.direction;

                if (dir === 'left') document.body.classList.add('fade-left');
                else document.body.classList.add('fade-right');

                setTimeout(() => window.location.href = href, 420);
            });
        });
    </script>
}
